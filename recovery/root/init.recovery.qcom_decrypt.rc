# ============================================================
# FBE decrypt stack — Nothing Phone 3 (Metroid)
# wrappedkey_v0 + inlinecrypt + aes-256-xts:aes-256-cts:v2, KeyMint AIDL v3
# Chain: qseecomd -> listeners.registered -> KeyMint(AIDL) -> keystore2 -> vold
#
# STATUS: full stack comes up; wall is TrustZone (see DECRYPT_FINDINGS.md).
# KeyMint hangs on getRootOfTrust in futex_wait because bootloader is unlocked
# (verifiedbootstate=orange). Everything below the TZ handshake works.
#
# REQUIRES: A16 lib set in /persist/decrypt_libs/ (libbinder, libbinder_ndk,
# libapexsupport, libvndksupport, libc++) — see DECRYPT_FINDINGS.md for how to pull.
# ============================================================

on early-init
    setprop keystore.boot_level 0

# --- services (all disabled, started by triggers below) ---
# namespace: A16 libs from /persist first, to bridge A14-recovery <-> A15-vendor ABI gap

service vendor.qseecomd /vendor/bin/qseecomd
    socket notify-topology stream 660 system drmrpc
    class core
    user root
    group root drmrpc system
    seclabel u:r:recovery:s0
    setenv LD_LIBRARY_PATH /persist/decrypt_libs:/vendor/lib64:/vendor/lib64/hw
    disabled

service vendor.keymint-qti /vendor/bin/hw/android.hardware.security.keymint-service-qti
    class core
    user root
    group root drmrpc system
    seclabel u:r:recovery:s0
    setenv LD_LIBRARY_PATH /persist/decrypt_libs:/vendor/lib64:/vendor/lib64/hw
    disabled

service keystore2 /system/bin/keystore2 /tmp/misc/keystore
    class main
    user root
    group root keystore readproc log
    seclabel u:r:recovery:s0
    disabled

# --- trigger: encrypted FBE data present ---
on property:ro.crypto.state=encrypted && property:ro.crypto.type=file
    # dma-heap perms: recovery ueventd makes these 0600 root:root; OS has 0644 system:system
    chmod 0644 /dev/dma_heap/qcom,qseecom
    chown system system /dev/dma_heap/qcom,qseecom
    chmod 0644 /dev/dma_heap/qcom,qseecom-ta
    chown system system /dev/dma_heap/qcom,qseecom-ta
    setprop keystore.boot_level 0
    # mount vendor + odm (odm breaks the /odm->/vendor/odm->/odm symlink loop -> NULL VINTF)
    wait /dev/block/mapper/vendor${ro.boot.slot_suffix} 5
    mount erofs /dev/block/mapper/vendor${ro.boot.slot_suffix} /vendor ro
    wait /dev/block/mapper/odm${ro.boot.slot_suffix} 5
    mount erofs /dev/block/mapper/odm${ro.boot.slot_suffix} /odm ro
    mkdir /tmp/misc 0700 root root
    mkdir /tmp/misc/keystore 0700 root root
    start vendor.qseecomd

# --- trigger: qseecomd registered TZ listeners ---
on property:vendor.sys.listeners.registered=true
    start vendor.keymint-qti
    start keystore2
